{
  "name": "true-mafia",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:server dev:client",
    "dev:server": "npm -w server run dev",
    "dev:client": "npm -w client run dev",
    "build": "npm -w shared run build && npm -w client run build",
    "typecheck": "tsc -b shared server client",
    "test": "npm -w server run test",
    "start": "npm -w server run start"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
